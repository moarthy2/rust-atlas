DISCORD_TOKEN=put-your-bot-token-here
# Optional: set to skip an API round-trip on startup for command registration.
# APPLICATION_ID=1234567890
# Custom AI provider (OpenAI-compatible). Ollama example: http://localhost:11434/v1
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# Context7 (https://context7.com/dashboard) — enables /context7 with fresh crate docs.
CONTEXT7_API_KEY=
# Set to 1/true to fetch+parse all 4 print.html pages at startup (faster first query, slower boot).
PRELOAD_DOCS=false
RUST_LOG=rust_docs_bot=info
